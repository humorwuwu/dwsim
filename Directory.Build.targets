<Project>
  <!-- Local Mono builds need the netstandard facade that the 4.6.2 pack lacks. -->
  <ItemGroup Condition="'$(NetStandardFacadesPath)' != ''">
    <Reference Include="netstandard">
      <HintPath>$(NetStandardFacadesPath)/netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    Mono has no WPF. Drop the WPF renderer and the two WPF Python consoles
    on non-Windows so Automation.Dynamics.Tests can compile. Windows keeps
    every reference. H2SIM_NO_WPF is undefined there, so the #if stays on.
  -->
  <!-- AssignProjectConfiguration copies ProjectReference before ResolveProjectReferences. Remove first. -->
  <Target Name="H2simDropWpfProjects" BeforeTargets="AssignProjectConfiguration" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_H2simWpfProject Include="@(ProjectReference)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('DWSIM.UI.Desktop.WPF')) Or $([System.String]::Copy('%(Identity)').Contains('IronPythonConsole')) Or $([System.String]::Copy('%(Identity)').Contains('PythonConsole'))" />
      <ProjectReference Remove="@(_H2simWpfProject)" />
      <Compile Remove="@(Compile)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('FormInteractiveIronPythonConsole'))" />
      <EmbeddedResource Remove="@(EmbeddedResource)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('FormInteractiveIronPythonConsole'))" />
    </ItemGroup>
    <Message Importance="high" Text="H2sim: skipping WPF project %(_H2simWpfProject.Identity)" Condition="'@(_H2simWpfProject)' != ''" />
  </Target>

  <Target Name="H2simDropWpfBuiltProjects" BeforeTargets="ResolveProjectReferences" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Remove="@(ProjectReferenceWithConfiguration)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('DWSIM.UI.Desktop.WPF')) Or $([System.String]::Copy('%(Identity)').Contains('IronPythonConsole')) Or $([System.String]::Copy('%(Identity)').Contains('PythonConsole'))" />
    </ItemGroup>
  </Target>

  <Target Name="H2simDropWpfReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <Reference Remove="@(Reference)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('Presentation')) Or $([System.String]::Copy('%(Identity)').StartsWith('WindowsBase')) Or $([System.String]::Copy('%(Identity)').StartsWith('WindowsFormsIntegration')) Or $([System.String]::Copy('%(Identity)').StartsWith('System.Xaml')) Or $([System.String]::Copy('%(Identity)').Contains('Wpf')) Or $([System.String]::Copy('%(Identity)').Contains('WPF'))" />
    </ItemGroup>
  </Target>

  <!-- Mono's lc.exe exits 1 on WinForms licenses.licx. Drop them before SplitResourcesByCulture copies them to _LicxFile. -->
  <Target Name="H2simSkipLicx" BeforeTargets="SplitResourcesByCulture" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)" Condition="'%(Extension)' == '.licx'" />
    </ItemGroup>
  </Target>

  <Target Name="H2simNoWpfDefine" BeforeTargets="CoreCompile" Condition="'$(OS)' != 'Windows_NT'">
    <PropertyGroup>
      <DefineConstants Condition="'$(Language)' == 'C#'">$(DefineConstants);H2SIM_NO_WPF</DefineConstants>
      <!-- VB reads FinalDefineConstants, which is snapshotted from DefineConstants at evaluation. -->
      <FinalDefineConstants Condition="'$(Language)' == 'VB'">$(FinalDefineConstants),H2SIM_NO_WPF=True</FinalDefineConstants>
    </PropertyGroup>
  </Target>

  <!-- Local Mono builds need the backslash HintPaths normalized. -->
  <Target Name="H2simNormalizeHintPaths" BeforeTargets="ResolveAssemblyReferences" Condition="'$(OS)' != 'Windows_NT'">
    <Message Importance="high" Text="H2sim: normalizing HintPaths for Mono" />
    <ItemGroup>
      <_H2simReference Include="@(Reference)">
        <HintPath>$([System.String]::Copy('%(Reference.HintPath)').Replace('\','/'))</HintPath>
      </_H2simReference>
    </ItemGroup>
    <ItemGroup>
      <Reference Remove="@(Reference)" />
      <Reference Include="@(_H2simReference)" />
    </ItemGroup>
  </Target>

  <!--
    shortcut: 上游多个工程的 PostBuildEvent 假设 DistPackages 目录已存在，
    干净环境里末尾的 rd /s /q 返回 1，导致构建失败。这里在每个 PostBuildEvent
    前重建这些目录。T-0.2 移除 Linux / Windows_32 发行配置后可缩减此列表。
  -->
  <Target Name="H2simEnsureDistPackageDirs"
          BeforeTargets="PostBuildEvent;AfterBuild"
          Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)DistPackages\Windows\plugins\x86;$(MSBuildThisFileDirectory)DistPackages\Windows\plugins\x64;$(MSBuildThisFileDirectory)DistPackages\Windows\x86;$(MSBuildThisFileDirectory)DistPackages\Windows\x64;$(MSBuildThisFileDirectory)DistPackages\Windows_32\plugins\x86;$(MSBuildThisFileDirectory)DistPackages\Windows_32\plugins\x64;$(MSBuildThisFileDirectory)DistPackages\Windows_32\x86;$(MSBuildThisFileDirectory)DistPackages\Windows_32\x64;$(MSBuildThisFileDirectory)DistPackages\macOS\plugins\x86;$(MSBuildThisFileDirectory)DistPackages\macOS\plugins\x64;$(MSBuildThisFileDirectory)DistPackages\macOS\x86;$(MSBuildThisFileDirectory)DistPackages\macOS\x64;$(MSBuildThisFileDirectory)DistPackages\Linux\plugins\x86;$(MSBuildThisFileDirectory)DistPackages\Linux\plugins\x64;$(MSBuildThisFileDirectory)DistPackages\Linux\x86;$(MSBuildThisFileDirectory)DistPackages\Linux\x64" />
  </Target>
</Project>